ERCOT_USERNAME=
ERCOT_PASSWORD=
ERCOT_SUBSCRIPTION_KEY=
BASE_CAPACITY_KWH=39.2
BASE_POWER_KW=11.5
SOC_RESERVE=0.20
SIM_TIME_SCALE=1
FLEET_SIZE=3000
PERSIST_SAMPLE=60

# Optional. Leave both blank to keep the dispatch call inside this process.
# The service-role key must not be pasted into chat or shipped to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional model endpoint. Empty means actions only come from Supabase or POST /api/actions.
LLM_URL=
LLM_EVERY_S=600

# Comma-separated browser origins when the map is not served by this process.
WEB_ORIGIN=
# Set to 0 on the Render bot so it does not also serve the map.
SERVE_STATIC=1
